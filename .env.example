# GroundedDocs environment configuration.
# Copy to `.env` and fill in values. Never commit `.env`.

# --- Service ---------------------------------------------------------------
GROUNDEDDOCS_ENVIRONMENT=development
GROUNDEDDOCS_LOG_LEVEL=INFO

# --- Security (enforced from Phase 5) --------------------------------------
# Leave empty for local development; set to a strong value in production.
# GROUNDEDDOCS_API_KEY=

# --- Groq (LLM inference; required from Phase 3 onward) --------------------
GROQ_API_KEY=

# --- Qdrant (vector store) --------------------------------------------------
GROUNDEDDOCS_QDRANT_URL=http://localhost:6333
GROUNDEDDOCS_QDRANT_COLLECTION=groundeddocs_chunks

# --- Models (single source of truth; versions resolved at load time) --------
# GROUNDEDDOCS_MODELS_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-large
# GROUNDEDDOCS_MODELS_EMBEDDING_DIM=1024
# GROUNDEDDOCS_MODELS_LLM_PROVIDER=groq
# GROUNDEDDOCS_MODELS_LLM_MODEL=llama-3.3-70b-versatile
# GROUNDEDDOCS_MODELS_RERANKER_CROSS_ENCODER_ID=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Reranker mode: auto | cross_encoder | llm_judge ------------------------
# auto probes the GPU at startup and falls back to LLM-as-judge if unavailable.
GROUNDEDDOCS_RERANKER_MODE=auto

# --- Ingestion & chunking ----------------------------------------------------
# GROUNDEDDOCS_INGESTION_CHUNK_SIZE=512
# GROUNDEDDOCS_INGESTION_OVERLAP=50
# GROUNDEDDOCS_INGESTION_DEFAULT_STRATEGY=structure   # fixed | structure | semantic
# GROUNDEDDOCS_DEDUP_THRESHOLD=0.95
# GROUNDEDDOCS_DEDUP_MODE=skip                          # skip | flag
# GROUNDEDDOCS_DEDUP_SCOPE=all                          # all | same_document
# GROUNDEDDOCS_DEDUP_TOP_K=5
